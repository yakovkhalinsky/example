# Ollama Cloud (default): just the API key is needed.
OLLAMA_API_KEY=

# Or point at a local / self-hosted Ollama daemon (0.40.6+ for cloud models):
# OLLAMA_HOST=http://localhost:11434

# Model to call. Default clef:cloud. Local alternatives:
# clef, clef-flash, actbro/minicpm5-2b-jev
# JEV_MODEL=clef:cloud
